<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.ehcache.org/v3"
        xmlns:jsr107="http://www.ehcache.org/v3/jsr107"
        xsi:schemaLocation="
            http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core.xsd
            http://www.ehcache.org/v3/jsr107 http://www.ehcache.org/schema/ehcache-107-ext.xsd">

    <!--
        EhCache 3.x 配置文件，使用 JSR-107 标准

        配置说明：
        - heap: 堆内存中的最大条目数
        - offheap: 堆外内存大小
        - disk: 磁盘存储大小
        - ttl: 生存时间 (time-to-live)
        - tti: 空闲时间 (time-to-idle)
     -->

    <!-- 服务配置 -->
    <service>
        <jsr107:defaults enable-management="false" enable-statistics="false"/>
    </service>

    <!-- 启用本地持久化服务以支持磁盘资源层（放置在 config 顶层） -->
    <!-- 使用系统临时目录，确保对该目录有写权限 -->
    <persistence directory="./ehcache"/>

    <!-- 缓存模板定义 -->
    <cache-template name="defaultTemplate">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry>
            <ttl unit="minutes">2</ttl>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
            <offheap unit="MB">10</offheap>
        </resources>
    </cache-template>

    <!-- 临时缓存模板 -->
    <cache-template name="tempTemplate">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
            <offheap unit="MB">10</offheap>
        </resources>
    </cache-template>

    <!-- 永久缓存模板 -->
    <cache-template name="eternalTemplate">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry>
            <none/>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
            <offheap unit="MB">50</offheap>
            <disk unit="MB">100</disk>
        </resources>
    </cache-template>

    <!-- 具体缓存配置 -->

    <!-- 临时缓存 -->
    <cache alias="temp_cache" uses-template="tempTemplate"/>

    <!-- 永久缓存 -->
    <cache alias="eternal_cache" uses-template="eternalTemplate"/>

    <!-- 字典缓存 - 永不过期 -->
    <cache alias="sys_dict">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry>
            <none/>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
            <offheap unit="MB">20</offheap>
        </resources>
    </cache>

    <!-- 系统配置缓存 - 永不过期 -->
    <cache alias="sys_config">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry>
            <none/>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
            <offheap unit="MB">20</offheap>
        </resources>
    </cache>

    <!-- 防重复提交缓存 - 5秒过期 -->
    <cache alias="repeat_submit">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry>
            <ttl unit="seconds">5</ttl>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
        </resources>
    </cache>

    <!-- 验证码缓存 - 3分钟过期 -->
    <cache alias="captcha_codes">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry>
            <ttl unit="minutes">3</ttl>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
        </resources>
    </cache>

    <!-- 用户登录令牌缓存 - 30分钟过期，支持持久化 -->
    <cache alias="login_tokens">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
            <offheap unit="MB">20</offheap>
            <disk unit="MB" persistent="true">100</disk>
        </resources>
        <!-- 明确指定持久化策略 -->
        <heap-store-settings>
            <max-object-graph-size>10000</max-object-graph-size>
            <max-object-size unit="MB">1</max-object-size>
        </heap-store-settings>
    </cache>

    <!-- 限流缓存 - 3分钟过期 -->
    <cache alias="rate_limit">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
        </resources>
    </cache>

    <!-- 密码错误次数缓存 - 30分钟过期 -->
    <cache alias="pwd_err_cnt">
        <key-type>java.lang.String</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
        </resources>
    </cache>

</config>
